# Base de données — Postgres (Neon via Vercel Storage)
# schema.prisma pointe désormais sur "postgresql" en dur (plus de bascule SQLite/Postgres
# via variable d'env — voir §13 du CLAUDE.md pour l'historique de la transition).
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."   # requis par Prisma pour les migrations via le pooler

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"

# WebPush
VAPID_PUBLIC_KEY="changeme"
VAPID_PRIVATE_KEY="changeme"
VAPID_SUBJECT="mailto:contact@trackflow.app"

# Vercel Blob (vidéos)
BLOB_READ_WRITE_TOKEN="changeme"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="changeme"
