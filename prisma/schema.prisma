// TrackFlow — schéma Prisma
// Portage fidèle du modèle Doctrine/Symfony (repo Maksenoff/Trackflow, src/Entity/*.php)
// Règle: IDs en String (cuid) pour rester compatible SQLite (dev) -> PostgreSQL (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Utilisateurs & rôles
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  firstName    String
  lastName     String
  password     String
  // Plusieurs rôles simultanés possibles: ROLE_ADMIN, ROLE_COACH, ROLE_COMPETITION_MANAGER, ROLE_ATHLETE
  roles        String    @default("[]") // JSON string: ROLE_ADMIN, ROLE_COACH, ROLE_COMPETITION_MANAGER, ROLE_ATHLETE
  disabled     Boolean   @default(false) // compte désactivé par un admin : connexion bloquée
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime? // horodatage de la dernière authentification réussie — peu parlant si la session reste ouverte des jours
  lastActiveAt DateTime? // dernière requête authentifiée reçue de cet utilisateur (voir components/activity-ping.tsx) — reflète le réel dernier usage de l'app

  linkedAthleteId String?  @unique
  linkedAthlete   Athlete? @relation("UserLinkedAthlete", fields: [linkedAthleteId], references: [id], onDelete: SetNull)

  feedbacks          Feedback[]
  notifications      Notification[]
  dismissedReminders DismissedReminder[]
  pushSubscriptions  PushSubscription[]
  createdPolls       Poll[]
  pollVotes          PollVote[]
  coachedSessions    Session[]

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// Athlète
// ---------------------------------------------------------------------------

model Athlete {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  birthDate        DateTime?
  gender           String?
  disciplines      String    @default("[]") // JSON string array
  disciplineColors String    @default("{}") // JSON string object
  notes            String?
  photoUrl         String?
  photoConfig      String    @default("{}") // JSON string object: { zoom, x, y }
  bannerUrl        String?
  bannerConfig     String    @default("{}") // JSON string object: { mode, pattern, color, zoom, x, y }
  licenseNumber    String?
  ffaProfileUrl    String?
  ffaSyncSinceYear Int? // saison de départ (année de début, ex: 2015 = saison 2015/2016) — performances antérieures ignorées à la sync
  lastSyncedAt     DateTime?
  videosEnabled    Boolean   @default(false) // onglet Vidéos visible sur le profil — activable par un admin
  createdAt        DateTime  @default(now())

  user                     User?                     @relation("UserLinkedAthlete")
  performances             Performance[]
  podiums                  Podium[]
  goals                    Goal[]
  athleteSessions          AthleteSession[]
  customSessions           AthleteCustomSession[]
  videos                   AthleteVideo[]
  notesList                AthleteNote[]
  competitionRegistrations CompetitionRegistration[]
  teamMemberships          TeamMember[]

  @@map("athlete")
}

model AthleteNote {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  pinned    Boolean  @default(false)
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@map("athlete_note")
}

model AthleteSession {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  comment    String?
  difficulty Int? // RPE 0-10
  skipped    Boolean  @default(false)
  loggedAt   DateTime @default(now())

  @@unique([athleteId, sessionId])
  @@index([sessionId])
  @@map("athlete_session")
}

model AthleteCustomSession {
  id          String   @id @default(cuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title       String
  comment     String?
  difficulty  Int?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([athleteId])
  @@map("athlete_custom_session")
}

model AthleteVideo {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title      String
  discipline String?
  url        String
  createdAt  DateTime @default(now())

  @@index([athleteId])
  @@map("athlete_video")
}

// ---------------------------------------------------------------------------
// Équipes
// ---------------------------------------------------------------------------

// Équipes de relais (4x100/4x400...) : jusqu'à 4 athlètes, ordonnés (relayOrder)
// avec une marque de transmission (handoffMark) entre chaque coureur et le
// suivant — non structurellement limité à 4 côté schéma (un athlète peut être
// ajouté sans position, ex: remplaçant), mais l'UI plafonne à 4 positions.
model Team {
  id           String            @id @default(cuid())
  name         String
  color        String? // hex, palette DEFAULT_DISCIPLINE_COLORS (même que les profils)
  photoUrl     String?
  photoConfig  String            @default("{}") // JSON string object: { zoom, x, y } — même éditeur de cadrage que la photo athlète
  createdAt    DateTime          @default(now())
  members      TeamMember[]
  performances TeamPerformance[]

  @@map("team")
}

// Historique des performances de l'équipe (temps de relais lors des compétitions).
model TeamPerformance {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  time      String // format libre : "42.15", "3:24.50"...
  location  String?
  date      DateTime
  place     Int? // classement à la course
  createdAt DateTime @default(now())

  @@index([teamId])
  @@map("team_performance")
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  relayOrder  Int? // position 1-4 dans le relais, null = pas encore positionné
  handoffMark String? // repère de transmission vers le coureur suivant (pieds, marque au sol...) — sans objet pour la position 4
  addedAt     DateTime @default(now())

  @@unique([teamId, athleteId])
  @@index([athleteId])
  @@map("team_member")
}

// ---------------------------------------------------------------------------
// Configuration club (singleton)
// ---------------------------------------------------------------------------

// Une seule ligne (id fixe "main") — réglages globaux du club, affichés sur les
// documents générés (ex: numéro de club sur les fiches relais).
model ClubSettings {
  id       String  @id @default("main")
  clubCode String?

  @@map("club_settings")
}

// ---------------------------------------------------------------------------
// Performances & objectifs
// ---------------------------------------------------------------------------

model Performance {
  id             String   @id @default(cuid())
  athleteId      String
  athlete        Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  discipline     String
  value          Float
  unit           String
  notes          String?
  recordedAt     DateTime @default(now())
  isPersonalBest Boolean  @default(false)
  isCompetition  Boolean  @default(false)
  isIndoor       Boolean?
  venue          String?
  level          String?
  levelPoints    Int?
  wind           String?

  @@index([athleteId])
  @@index([sessionId])
  @@map("performance")
}

model Podium {
  id          String   @id @default(cuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  year        Int
  rank        Int // 1, 2 ou 3
  label       String? // texte brut FFA de la colonne "Place" (ex: "Champion JUM - H-F") — vide si ajouté manuellement
  level       String // "Régional", "National", "Départemental", "Club"... (regroupement FFA ou libre si manuel)
  discipline  String // texte brut FFA de la colonne "Epreuve", ou libre si manuel
  performance String? // texte brut affiché (ex: "14''79 (+0.7)")
  recordedAt  DateTime
  venue       String?
  source      String   @default("ffa") // "ffa" (scrapé) ou "manual" (ajouté par un coach/l'athlète)

  @@unique([athleteId, year, rank, discipline, recordedAt])
  @@map("podium")
}

model Goal {
  id              String    @id @default(cuid())
  athleteId       String
  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title           String
  discipline      String?
  targetValue     Float?
  unit            String?
  deadline        DateTime?
  status          String    @default("in_progress") // in_progress | achieved | abandoned
  // Si true : à chaque sync FFA, une performance de cette discipline postérieure
  // à createdAt qui dépasse targetValue fait passer status à "achieved" tout seul
  // (voir lib/goals.ts::autoValidateGoalsForAthlete, appelé depuis lib/ffa-scraper.ts).
  autoValidateFfa Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([athleteId])
  @@map("goal")
}

// ---------------------------------------------------------------------------
// Entraînement
// ---------------------------------------------------------------------------

model TrainingType {
  id       String    @id @default(cuid())
  name     String
  color    String    @default("#6366f1")
  sessions Session[]

  @@map("training_type")
}

model Session {
  id              String           @id @default(cuid())
  title           String
  date            DateTime         @default(now())
  trainingTypeId  String?
  trainingType    TrainingType?    @relation(fields: [trainingTypeId], references: [id], onDelete: SetNull)
  description     String?
  durationMinutes Int?
  startTime       DateTime?
  coachId         String?
  coach           User?            @relation(fields: [coachId], references: [id], onDelete: SetNull)
  coachPresent    Boolean          @default(true)
  athleteSessions AthleteSession[]
  performances    Performance[]

  @@index([date])
  @@index([trainingTypeId])
  @@index([coachId])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Compétitions
// ---------------------------------------------------------------------------

model CompetitionType {
  id           String        @id @default(cuid())
  name         String
  color        String        @default("#f59e0b")
  competitions Competition[]

  @@map("competition_type")
}

model Competition {
  id                   String                    @id @default(cuid())
  title                String
  location             String?
  date                 DateTime                  @default(now())
  competitionTypeId    String?
  competitionType      CompetitionType?          @relation(fields: [competitionTypeId], references: [id], onDelete: SetNull)
  documentUrl          String?
  schedulesUrl         String?
  websiteUrl           String?
  description          String?
  availableDisciplines String                    @default("[]") // JSON string array
  requestExpectedPerf  Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  registrations        CompetitionRegistration[]

  @@index([date])
  @@index([competitionTypeId])
  @@map("competition")
}

model CompetitionRegistration {
  id                   String              @id @default(cuid())
  athleteId            String
  athlete              Athlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  competitionId        String
  competition          Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  disciplines          String              @default("[]") // JSON string array
  registeredAt         DateTime            @default(now())
  ffaRegistered        Boolean             @default(false)
  expectedPerformances String? // JSON string object
  debrief              CompetitionDebrief?

  @@unique([athleteId, competitionId])
  @@index([competitionId])
  @@map("competition_registration")
}

model CompetitionDebrief {
  id             String                  @id @default(cuid())
  registrationId String                  @unique
  registration   CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  feeling        Int?
  notes          String?
  skipped        Boolean                 @default(false)
  doneAt         DateTime                @default(now())

  @@map("competition_debrief")
}

// ---------------------------------------------------------------------------
// Notifications, feedback, push
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // feedback | debrief | competition | ffa
  title     String
  body      String
  url       String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

// Rappels calculés à la volée (lib/notifications.ts : "séance à débriefer", "séance
// dans 2h"...) : pas de ligne Notification en base, donc rien à supprimer via
// DELETE /api/notifications/[id]. Cette table retient juste "cet utilisateur a masqué
// ce rappel précis" (key = id synthétique du flux, ex: "debrief-{sessionId}" ou
// "session-soon-{sessionId}"), vérifiée en excluant ces clés du calcul du flux.
model DismissedReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("dismissed_reminder")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  publicKey String
  authToken String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

model Feedback {
  id          String      @id @default(cuid())
  type        String      @default("bug") // bug | suggestion
  description String
  page        String?
  status      String      @default("new") // new | in_progress | done
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?
  authorEmail String?
  adminNote   String?
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?
  pollOption  PollOption?

  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Votes communauté
// ---------------------------------------------------------------------------

// Confrontation entre deux suggestions (Feedback) choisies par un admin, chacune
// reformulée proprement. Chaque utilisateur vote pour l'une des deux, durée libre
// (début/fin) fixée à la création, résultats visibles uniquement une fois expiré.
model Poll {
  id          String       @id @default(cuid())
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  startsAt    DateTime     @default(now()) // date de début choisie par l'admin — le vote n'est ouvert qu'à partir de cette date
  expiresAt   DateTime
  options     PollOption[]
  votes       PollVote[]

  @@map("poll")
}

model PollOption {
  id         String     @id @default(cuid())
  pollId     String
  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  feedbackId String     @unique
  feedback   Feedback   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  label      String // reformulation admin de la suggestion originale
  votes      PollVote[]

  @@map("poll_option")
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedAt  DateTime   @default(now())

  @@unique([pollId, userId])
  @@map("poll_vote")
}
